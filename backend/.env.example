# ============================================================
#  Morfi Center · backend/.env  (copiar este archivo a backend/.env)
#  Todas las claves tienen un valor por defecto en app/core/config.py;
#  acá solo hace falta lo que quieras cambiar o los secretos reales.
# ============================================================

# ── App ─────────────────────────────────────────────────
APP_ENV=development                 # development | production
APP_NAME=Morfi Center
APP_TIMEZONE=America/Argentina/Buenos_Aires
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5500

# ── Base de datos ──────────────────────────────────────
DATABASE_URL=sqlite:///./data/morfi.db

# ── Auth / JWT ─────────────────────────────────────────
# Obligatorio en producción. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_TOKEN_MINUTES=30

# ── Google OAuth ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Servicios externos ─────────────────────────────────
GEOCODING_PROVIDER=nominatim         # nominatim | google
NOMINATIM_USER_AGENT=morfi-center-dev
GOOGLE_MAPS_API_KEY=
ROUTE_PROVIDER=manual                # manual | osrm | google

# ── Almacenamiento de archivos ─────────────────────────
STORAGE_DIR=./storage
MAX_UPLOAD_MB=8

# ── Tareas programadas ─────────────────────────────────
RESERVATION_TTL_MIN=40
